### 11. `backend/main.py`

Sits directly inside `backend/main.py` and automatically configures `sys.path` so imports from `server.*` resolve cleanly regardless of the working directory.

```python
import os
import sys

# Ensure 'backend/' is on sys.path so 'from server...' works from any directory
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from fastapi import FastAPI, Query
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel
from server.spherex_pipeline import pipeline

app = FastAPI(title="Space-Max 0 Discovery Engine")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

rlhf_feedback_memory = []

class RLHFFeedbackPayload(BaseModel):
    ra: float
    dec: float
    user_vote: str  # "confirm_planet" | "flag_artifact" | "known_star"

@app.get("/api/scan")
def run_discovery_pipeline(
    live_gaia: bool = Query(False, description="Run live ESA Gaia DR3 cone search"),
    live_skyview: bool = Query(False, description="Query live NASA SkyView before mockup fallback")
):
    return pipeline.execute_full_scan(live_gaia=live_gaia, live_skyview=live_skyview)

@app.get("/api/datacube")
def get_3d_datacube(x_pos: float = 1569.5, y_pos: float = 237.6):
    return pipeline.extract_3d_datacube(x_pos=x_pos, y_pos=y_pos)

@app.post("/api/feedback")
def record_rlhf_feedback(payload: RLHFFeedbackPayload):
    reward = 1 if payload.user_vote == "confirm_planet" else -1
    entry = {
        "ra": payload.ra,
        "dec": payload.dec,
        "user_vote": payload.user_vote,
        "rl_reward": reward
    }
    rlhf_feedback_memory.append(entry)
    return {
        "status": "feedback_recorded",
        "total_community_votes": len(rlhf_feedback_memory),
        "latest_entry": entry
    }

